---
import { BASE, SHOW_IMAGES } from "../config.ts";
import HeroImage from "./HeroImage.astro";

const { title, slug, heroImage } = Astro.props;
---

<a href={BASE + `/projects/${slug}/`}>
  <div
    class="flex flex-col w-64 border border-base-300 dark:border-base-700 rounded-2xl overflow-hidden"
  >
    {
      !SHOW_IMAGES || !heroImage ? null : (
        <div class="relative aspect-[16/9] w-full shrink-0">
          <HeroImage image={heroImage} />
        </div>
      )
    }
    <div class="p-4">{title}</div>
  </div>
</a>
