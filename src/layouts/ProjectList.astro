---
import ProjectEntry from "$components/ProjectEntry.astro";
import ProseWrapper from "./ProseWrapper.astro";

type Props = {
  projects: Array<any>;
};

const { projects } = Astro.props;
---

<div class="flex items-start justify-between gap-4 pb-8">
  <ProseWrapper>
    <slot />
  </ProseWrapper>
</div>

<div class="my-14 space-y-16 max-w-3xl">
  {
    projects.map((project: any) => (
      <ProjectEntry {...project.data} slug={project.id} />
    ))
  }
</div>
