---
import { BASE, SITE_TITLE, SITE_DESCRIPTION } from "../config.ts";
import { getProjects } from "../utils";
import ProjectList from "$layouts/ProjectList.astro";
import ProseWrapper from "./ProseWrapper.astro";
import LatestBlogEntry from "$components/LatestBlogEntry.astro";

const projects = await getProjects();
---

<main class="max-w-2xl lg:max-w-3xl mx-auto mt-16 px-4">
  <h1 class="text-4xl font-bold text-base-900 dark:text-base-50">
    {SITE_TITLE}
  </h1>
  <p class="mt-4 text-base-600 dark:text-base-400">{SITE_DESCRIPTION}</p>
  <ProseWrapper>
    <h2>Blog</h2>
    <h3>Latest post:</h3>
  </ProseWrapper>
  <LatestBlogEntry />
  <a
    href={BASE + "/blog"}
    class="mt-8 inline-block text-accent-600 dark:text-accent-400 font-semibold hover:underline"
  >
    Read the blog →
  </a>
  <hr class="my-12 border-base-200 dark:border-base-700" />
  <ProseWrapper>
    <h2>Projects</h2>
  </ProseWrapper>
  <ProjectList {projects} />
</main>
