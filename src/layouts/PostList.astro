---
import { BASE, SITE_TITLE, SITE_DESCRIPTION, SHOW_RSS } from "../config.ts";

import Footer from "$components/Footer.astro";
import Header from "$components/Header.astro";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogEntry from "$components/BlogEntry.astro";

import Pagination from "$components/Pagination.astro";
import ProseWrapper from "./ProseWrapper.astro";
import BigBlogEntry from "$components/BigBlogEntry.astro";

type Props = {
  posts: Array<any>;
  totalPages: number;
  currentPage: number;
  tag?: string;
  showFeatured?: boolean;
};

const { posts, totalPages, currentPage, tag, showFeatured } = Astro.props;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header active="blog" />
  <main class="max-w-2xl lg:max-w-3xl mx-auto mt-8 px-4">
    <div class="flex items-start justify-between gap-4 pb-8">
      <ProseWrapper>
        <slot />
      </ProseWrapper>
      {
        SHOW_RSS ? (
          <a
            target="_blank"
            href={BASE + "/blog/rss.xml"}
            class="shrink-0 mt-2 text-base-600 hover:text-base-800 dark:text-base-400 dark:hover:text-base-200"
          >
            <span class="sr-only">RSS feed</span>

            <svg
              class="w-6 h-6"
              viewBox="-1 -1 22 22"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
            >
              <rect x="0" fill="none" width="20" height="20" />

              <g>
                <path d="M14.92 18H18C18 9.32 10.82 2.25 2 2.25v3.02c7.12 0 12.92 5.71 12.92 12.73zm-5.44 0h3.08C12.56 12.27 7.82 7.6 2 7.6v3.02c2 0 3.87.77 5.29 2.16C8.7 14.17 9.48 16.03 9.48 18zm-5.35-.02c1.17 0 2.13-.93 2.13-2.09 0-1.15-.96-2.09-2.13-2.09-1.18 0-2.13.94-2.13 2.09 0 1.16.95 2.09 2.13 2.09z" />
              </g>
            </svg>
          </a>
        ) : null
      }
    </div>

    {
      showFeatured ? (
        <BigBlogEntry {...posts[0].data} slug={posts[0].id} />
      ) : null
    }
    <div class="my-14 space-y-16 max-w-3xl">
      {
        posts.map((post: any, index: number) =>
          index > 0 || !showFeatured ? (
            <BlogEntry {...post.data} slug={post.id} />
          ) : null,
        )
      }
    </div>

    {
      totalPages > 1 ? (
        <Pagination current={currentPage} total={totalPages} {tag} />
      ) : null
    }
  </main>

  <Footer />
</BaseLayout>
