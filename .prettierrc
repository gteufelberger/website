{
  "plugins": [
    "prettier-plugin-svelte",
    "prettier-plugin-astro",
    "prettier-plugin-multiline-arrays"
  ],
  "multilineArraysWrapThreshold": 0,
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ]
}
